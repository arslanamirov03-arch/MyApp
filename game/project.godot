; Engine configuration file.
; Spider House — realistic spider simulator in a dark evening house.

config_version=5

[application]

config/name="Spider House"
config/description="A giant spider loose in a dark house. Walk, run, jump and climb every wall and ceiling."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/ui/icon.png"
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=12.0
common/physics_ticks_per_second=60
jolt_physics_3d/limits/max_linear_velocity=200.0

[rendering]

occlusion_culling/use_occlusion_culling=true
occlusion_culling/bvh_build_quality=1

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/atlas_size.mobile=2048
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=2
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/ssao/quality=2
environment/ssil/quality=1
environment/glow/upscale_mode=1
scaling_3d/mode=1
scaling_3d/fsr_sharpness=0.25
anti_aliasing/quality/use_debanding=true
