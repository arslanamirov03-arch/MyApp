<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF10203E"
                android:endColor="#FF0A1222" />
            <stroke android:width="1.5dp" android:color="#FF77A8FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#FF0C1729"
                android:endColor="#FF080D18" />
            <stroke android:width="1.5dp" android:color="#593E7BFF" />
        </shape>
    </item>
</selector>
